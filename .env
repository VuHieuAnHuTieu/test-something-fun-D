# ==============================================================================
# LOCAL-ONLY RUNTIME CONFIGURATION
# ==============================================================================
LOCAL_ONLY=true

# Local Ollama Configuration (Running on PC)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Database Configuration (Local MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

MYSQL_BUSINESS_DB=sakila_extended
MYSQL_AGENT_DB=agent_system

MYSQL_READ_USER=bi_reader
MYSQL_READ_PASSWORD=bi_reader_secret

MYSQL_APP_USER=agent_app
MYSQL_APP_PASSWORD=agent_app_secret

# Security, Capping & Audit
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=10.0
AUDIT_LOG_PATH=logs/audit.jsonl
APP_ENV=development
